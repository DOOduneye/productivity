{
  "name": "client",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "format": "trunk fmt ./",
    "lint": "trunk check ./",
    "lint:fix": "trunk check --fix ./",
    "start": "remix-serve ./build/server/index.js",
